{
  "name": "@sudabon/create-branch-name",
  "version": "0.1.0",
  "description": "Generate git branch names using LLM (ChatGPT)",
  "main": "dist/index.js",
  "bin": {
    "create-branch-name": "./dist/bin/create-branch-name.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/bin/create-branch-name.js",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "git",
    "branch",
    "cli",
    "llm",
    "chatgpt"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "inquirer": "^9.2.12",
    "openai": "^4.20.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.3",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "ts-jest": "^29.1.1",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
